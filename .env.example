# ============================================
# LLM 主模型配置（用于 Agent 对话）
# ============================================

# 模型提供商: openai, anthropic, deepseek, openrouter
# 或任何 OpenAI 兼容 API（如 SiliconFlow、本地 vLLM 等）
LLM_PROVIDER=deepseek

# API 密钥
LLM_API_KEY=your-api-key-here

# 模型 ID（不同提供商的模型名称）
# - DeepSeek: deepseek-chat, deepseek-reasoner
# - OpenAI: gpt-4o, gpt-4o-mini, gpt-3.5-turbo
# - Anthropic: claude-3-5-sonnet-20241022, claude-3-opus-20240229
# - OpenRouter: deepseek/deepseek-chat, anthropic/claude-3.5-sonnet
LLM_MODEL_ID=deepseek-chat

# API 端点 URL（可选，用于自定义端点或兼容 OpenAI 格式的服务）
# - DeepSeek: https://api.deepseek.com （如不设置会自动使用）
# - OpenRouter: https://openrouter.ai/api/v1 （如不设置会自动使用）
# - 本地模型: http://localhost:8000/v1
# - SiliconFlow: https://api.siliconflow.cn/v1
LLM_API_URL=

# ============================================
# 记忆整理器 LLM 配置（可选）
# ============================================
# 默认复用主 LLM 配置，如需使用不同模型（如更便宜的模型做整理）可单独设置

# CONSOLIDATION_LLM_PROVIDER=openai
# CONSOLIDATION_LLM_API_KEY=your-api-key
# CONSOLIDATION_LLM_MODEL_ID=gpt-4o-mini
# CONSOLIDATION_LLM_API_URL=

# 整理器超参数（可选）
CONSOLIDATION_TEMPERATURE=0.1
CONSOLIDATION_MAX_TOKENS=4096

# ============================================
# Embedding 配置（用于向量记忆检索）
# ============================================

EMBEDDING_API_URL=https://api.siliconflow.cn/v1/embeddings
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
EMBEDDING_DIM=1024
EMBEDDING_API_KEY=your-embedding-api-key

# ============================================
# 应用配置
# ============================================

AGENT_LOG_ENABLED=true

# 记忆整理间隔（轮）
CONSOLIDATION_INTERVAL=20

# 记忆上下文行数
MEMORY_CONTEXT_LINES=30

# 对话历史条数配置
HISTORY_LIMIT_NARRATOR=20
HISTORY_LIMIT_DEFAULT=10

# ============================================
# 旧版配置兼容（仍可使用，但建议迁移到上方新配置）
# ============================================
# DEEPSEEK_API_KEY=your-deepseek-api-key
# MODEL_ID=deepseek-chat

AGNO_TELEMETRY=false
VECTOR_SEARCH_LIMIT=5
MAX_EVENTS_COUNT=10
# Agent 运行超时时间（秒）
AGENT_RUN_TIMEOUT_SECONDS=30

# 角色回复后处理配置
MAX_ACTIONS=3
MAX_ELLIPSIS=3