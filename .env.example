# ============================================
# LLM 主模型配置（用于 Agent 对话）
# ============================================

# 模型提供商: openai, anthropic, deepseek, openrouter
# 或任何 OpenAI 兼容 API（如 SiliconFlow、本地 vLLM 等）
LLM_PROVIDER=deepseek

# API 密钥
LLM_API_KEY=your-api-key-here

# 模型 ID（不同提供商的模型名称）
# - DeepSeek: deepseek-chat, deepseek-reasoner
# - OpenAI: gpt-4o, gpt-4o-mini, gpt-3.5-turbo
# - OpenRouter: deepseek/deepseek-chat, anthropic/claude-3.5-sonnet
LLM_MODEL_ID=deepseek-chat

# API 端点 URL（可选，用于自定义端点或兼容 OpenAI 格式的服务）
# - DeepSeek: https://api.deepseek.com （如不设置会自动使用）
# - OpenRouter: https://openrouter.ai/api/v1 （如不设置会自动使用）
# - 本地模型: http://localhost:8000/v1
# - SiliconFlow: https://api.siliconflow.cn/v1
LLM_API_URL=

# ============================================
# 记忆整理器 LLM 配置（可选）
# ============================================
# 默认复用主 LLM 配置，如需使用不同模型（如免费模型做整理）可单独设置
CONSOLIDATION_LLM_PROVIDER=openrouter
CONSOLIDATION_LLM_API_KEY=your-api-key-here
CONSOLIDATION_LLM_MODEL_ID=stepfun/step-3.5-flash:free
CONSOLIDATION_LLM_API_URL=

# ============================================
# 旁白（narrator）LLM 配置（可选）
# ============================================
# 默认复用主 LLM 配置，如需使用更快的模型降低延迟可单独设置

NARRATOR_LLM_PROVIDER=openrouter
NARRATOR_LLM_API_KEY=your-api-key-here
NARRATOR_LLM_MODEL_ID=google/gemini-2.5-flash
NARRATOR_LLM_API_URL=

# ============================================
# 选项生成（choices）LLM 配置（可选）
# ============================================
# 默认复用旁白 LLM 配置，如需使用不同模型可单独设置

CHOICES_LLM_PROVIDER=
CHOICES_LLM_API_KEY=
CHOICES_LLM_MODEL_ID=
CHOICES_LLM_API_URL=

# ============================================
# Embedding 配置（用于向量记忆检索）
# ============================================

EMBEDDING_API_URL=https://api.siliconflow.cn/v1/embeddings
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_API_KEY=your-api-key-here

# Rerank 模型（可选）：在向量检索后进行精排，提升相关性
# 兼容 Jina / Cohere / Voyage 等 OpenAI 兼容 rerank 端点
# 不配置 RERANK_MODEL 则跳过 rerank 步骤
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_API_URL=https://api.siliconflow.cn/v1/rerank
RERANK_API_KEY=your-api-key-here

# ============================================
# 应用配置
# ============================================

AGENT_LOG_ENABLED=true