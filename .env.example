# ============================================
# LLM 主模型配置（用于 Agent 对话）
# ============================================

# 模型提供商: openai, anthropic, deepseek, openrouter 或任何 OpenAI 兼容 API（如 SiliconFlow、本地 vLLM 等）
# 建议使用有一定推理能力的模型，不应该使用过于基础的模型
LLM_PROVIDER=deepseek
LLM_API_KEY=your-deepseek-api-key
LLM_MODEL_ID=deepseek-chat
LLM_API_URL=

# ============================================
# 记忆整理器 LLM 配置（可选）
# ============================================
# 默认复用主 LLM 配置，如需使用不同模型（如免费模型做整理）可单独设置
# 这里建议使用中文模型，因记忆整理通常涉及对话历史的理解和总结，中文模型在处理中文内容时更具优势
# 无需太好的模型，但应该是中文模型
CONSOLIDATION_LLM_PROVIDER=openrouter
CONSOLIDATION_LLM_API_KEY=your-openrouter-api-key
CONSOLIDATION_LLM_MODEL_ID=stepfun/step-3.5-flash:free
CONSOLIDATION_LLM_API_URL=

# ============================================
# 旁白（narrator）LLM 配置（可选）
# ============================================
# 默认复用主 LLM 配置，如需使用更快的模型降低延迟可单独设置
# 建议使用有一定推理能力的模型
NARRATOR_LLM_PROVIDER=deepseek
NARRATOR_LLM_API_KEY=your-deepseek-api-key
NARRATOR_LLM_MODEL_ID=deepseek-chat
NARRATOR_LLM_API_URL=

# ============================================
# 选项生成（choices）LLM 配置（可选）
# ============================================
# 默认复用旁白 LLM 配置，如需使用不同模型可单独设置
# 建议使用快且便宜的模型，推理能力不重要，重要的是快
CHOICES_LLM_PROVIDER=openrouter
CHOICES_LLM_API_KEY=your-openrouter-api-key
CHOICES_LLM_MODEL_ID=google/gemini-2.5-flash-lite
CHOICES_LLM_API_URL=

# ============================================
# Embedding 配置（用于向量记忆检索）
# ============================================

EMBEDDING_API_URL=https://api.siliconflow.cn/v1/embeddings
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_API_KEY=your-siliconflow-api-key

# Rerank 模型（可选）：在向量检索后进行精排，提升相关性
# 兼容 Jina / Cohere / Voyage 等 OpenAI 兼容 rerank 端点
# 不配置 RERANK_MODEL 则跳过 rerank 步骤
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_API_URL=https://api.siliconflow.cn/v1/rerank
RERANK_API_KEY=your-siliconflow-api-key

# ============================================
# 应用配置
# ============================================

AGENT_LOG_ENABLED=true

# ============================================
# Logfire（可选）
# ============================================
# 本地开发可通过 Logfire CLI 选择项目；部署环境通常使用 LOGFIRE_TOKEN
LOGFIRE_TOKEN=
LOGFIRE_SEND_TO_LOGFIRE=
LOGFIRE_ENVIRONMENT=development
