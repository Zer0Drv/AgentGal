# ============================================
# LLM 主模型配置（用于 Agent 对话）
# ============================================

LLM_API_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL_ID=deepseek-v4-pro

# ============================================
# 记忆整理器 LLM 配置（可选）
# ============================================
# 默认复用主 LLM 配置；如需使用不同模型，可单独设置 URL / key / model id

CONSOLIDATION_LLM_API_URL=
CONSOLIDATION_LLM_API_KEY=
CONSOLIDATION_LLM_MODEL_ID=

# ============================================
# Episode 闭合检测器 LLM 配置（可选）
# ============================================
# 默认复用主 LLM 配置；闭合判定输出极简结构化（dict[str, int]），
# 倾向使用稳定的主模型而非整理用的免费模型。

EPISODE_CLOSURE_DETECTOR_LLM_API_URL=
EPISODE_CLOSURE_DETECTOR_LLM_API_KEY=
EPISODE_CLOSURE_DETECTOR_LLM_MODEL_ID=

# ============================================
# 旁白（narrator）LLM 配置（可选）
# ============================================
# 默认复用主 LLM 配置，如需使用更快的模型降低延迟可单独设置

NARRATOR_LLM_API_URL=
NARRATOR_LLM_API_KEY=
NARRATOR_LLM_MODEL_ID=

# ============================================
# 选项生成（choices）LLM 配置（可选）
# ============================================
# 默认复用旁白 LLM 配置，如需使用不同模型可单独设置

CHOICES_LLM_API_URL=
CHOICES_LLM_API_KEY=
CHOICES_LLM_MODEL_ID=

# ============================================
# Embedding 配置（用于向量记忆检索）
# ============================================

EMBEDDING_API_URL=https://api.siliconflow.cn/v1/embeddings
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_API_KEY=

# Rerank 模型（可选）：在向量检索后进行精排，提升相关性
# 兼容 Jina / Cohere / Voyage 等 OpenAI 兼容 rerank 端点
# 不配置 RERANK_MODEL 则跳过 rerank 步骤
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_API_URL=https://api.siliconflow.cn/v1/rerank
RERANK_API_KEY=
