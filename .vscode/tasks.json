{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Chainlit (dev)",
      "type": "shell",
      "command": "uv",
      "args": [
        "run",
        "chainlit",
        "run",
        "app.py",
        "-w",
        "--host",
        "0.0.0.0",
        "--port",
        "8000"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      },
      "problemMatcher": []
    }
  ]
}
